{
  "expo": {
    "name": "高齡行人過馬路防護與步態分析",
    "slug": "safestride-senior-crossing",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "AI 陪走夥伴需要使用動作感測器分析步行狀態，不會上傳個人資料。"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anglezero.safestride",
      "versionCode": 2,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    }
  }
}
