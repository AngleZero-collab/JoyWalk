{
  "expo": {
    "name": "悅步 JoyWalk",
    "slug": "joywalk-senior-crossing",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/joywalk-icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "悅步 JoyWalk 需要讀取動作感測器，用於本機步態分析與安全提醒。資料只在手機端運算。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "悅步 JoyWalk 需要使用定位，在路口停等時估算安全通過秒數。定位資料不會上傳雲端。"
        }
      ],
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anglezero.safestride",
      "versionCode": 10,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/joywalk-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "splash": {
      "image": "./assets/joywalk-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
