{
  "expo": {
    "name": "高齡行人過馬路防護與步態分析",
    "slug": "safestride-senior-crossing",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "AI 陪走夥伴需要使用動作感測器分析步行狀態，不會上傳個人資料。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeStride 安行需要使用目前位置判斷是否停在路口，並估算安全通過秒數。"
        }
      ],
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anglezero.safestride",
      "versionCode": 4,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    }
  }
}
