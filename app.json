{
  "expo": {
    "name": "SafeStride 安行",
    "slug": "safestride-senior-crossing",
    "version": "1.3.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "SafeStride 需要讀取動作感測器，用於本機步態分析與安全提醒。資料只在手機端運算。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeStride 需要使用定位，在路口停等時估算安全通過秒數。定位資料不會上傳雲端。"
        }
      ],
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anglezero.safestride",
      "versionCode": 7,
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    }
  }
}
